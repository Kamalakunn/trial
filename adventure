/* ============================================================
   STATE
   ============================================================ */
let state = {
  playerName: "",
  currentLevel: 0,
  currentQ: 0,
  levelScore: 0,
  levelCorrect: 0,
  hintsLeft: 3,
  totalScore: 0,
  totalStars: 0,
  levelProgress: {}, // {levelId: {stars, score, bestScore}}
  shuffledQuestions: [],
  timer: null,
  timeLeft: 30,
  answered: false,
  previousScreen: "mapScreen"
};

/* ============================================================
   UTILITIES
   ============================================================ */
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0, 0);
}

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function saveProgress() {
  localStorage.setItem('englishAdventure', JSON.stringify({
    playerName: state.playerName,
    totalScore: state.totalScore,
    totalStars: state.totalStars,
    levelProgress: state.levelProgress
  }));
}

function loadProgress() {
  const data = localStorage.getItem('englishAdventure');
  if (data) {
    const p = JSON.parse(data);
    state.playerName = p.playerName || "";
    state.totalScore = p.totalScore || 0;
    state.totalStars = p.totalStars || 0;
    state.levelProgress = p.levelProgress || {};
  }
}

function saveLeaderboard(name, score, stars) {
  const lb = JSON.parse(localStorage.getItem('lb_englishAdv') || '[]');
  lb.push({ name, score, stars, date: new Date().toLocaleDateString() });
  lb.sort((a, b) => b.score - a.score);
  localStorage.setItem('lb_englishAdv', JSON.stringify(lb.slice(0, 10)));
}

function getLeaderboard() {
  return JSON.parse(localStorage.getItem('lb_englishAdv') || '[]');
}

function isLevelUnlocked(levelId) {
  if (levelId === 1) return true;
  return state.levelProgress[levelId - 1] && state.levelProgress[levelId - 1].stars > 0;
}

function confetti() {
  const colors = ['#FBBF24', '#EC4899', '#8B5CF6', '#3B82F6', '#10B981'];
  for (let i = 0; i < 50; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.animationDelay = Math.random() * 0.5 + 's';
    c.style.animationDuration = (2 + Math.random() * 2) + 's';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
}

/* ============================================================
   BACKGROUND BUBBLES
   ============================================================ */
function createBubbles() {
  const container = document.getElementById('bgBubbles');
  for (let i = 0; i < 15; i++) {
    const b = document.createElement('div');
    b.className = 'bubble';
    const size = 20 + Math.random() * 60;
    b.style.width = size + 'px';
    b.style.height = size + 'px';
    b.style.left = Math.random() * 100 + '%';
    b.style.animationDuration = (10 + Math.random() * 15) + 's';
    b.style.animationDelay = Math.random() * 10 + 's';
    container.appendChild(b);
  }
}

/* ============================================================
   START / MAP
   ============================================================ */
function startGame() {
  const name = document.getElementById('playerName').value.trim();
  if (!name) { alert("Please enter your name, hero!"); return; }
  state.playerName = name;
  loadProgress();
  if (!state.playerName) state.playerName = name;
  document.getElementById('displayName').textContent = state.playerName;
  renderMap();
  showScreen('mapScreen');
}

function renderMap() {
  const grid = document.getElementById('levelGrid');
  grid.innerHTML = '';
  document.getElementById('totalStars').textContent = state.totalStars;
  document.getElementById('totalScore').textContent = state.totalScore;

  LEVELS.forEach((lv, i) => {
    const unlocked = isLevelUnlocked(lv.id);
    const prog = state.levelProgress[lv.id] || { stars: 0, score: 0 };
    const stars = '⭐'.repeat(prog.stars) + '☆'.repeat(3 - prog.stars);

    const card = document.createElement('div');
    card.className = 'level-card' + (!unlocked ? ' locked' : '') + (prog.stars > 0 ? ' completed' : '');
    card.innerHTML = `
      ${!unlocked ? '<div class="lock-icon">🔒</div>' : ''}
      <div class="level-icon">${lv.icon}</div>
      <div class="level-name">Level ${lv.id}: ${lv.name}</div>
      <div class="level-desc">${lv.desc}</div>
      <div class="level-stars">${stars}</div>
      <div style="text-align:center; font-size:12px; margin-top:6px; opacity:.8;">Best: ${prog.score} pts</div>
    `;
    if (unlocked) card.onclick = () => startLevel(lv.id);
    grid.appendChild(card);
  });
}

function backToStart() {
  showScreen('startScreen');
}

/* ============================================================
   GAME LOGIC
   ============================================================ */
function startLevel(levelId) {
  const lv = LEVELS.find(l => l.id === levelId);
  state.currentLevel = levelId;
  state.currentQ = 0;
  state.levelScore = 0;
  state.levelCorrect = 0;
  state.hintsLeft = 3;
  state.answered = false;

  // Shuffle questions, but keep options order as-is for clarity (or shuffle too)
  state.shuffledQuestions = shuffle(lv.questions).map(q => {
    // Pair options with letters, then shuffle
    const opts = q.o.map((text, i) => ({ text, isCorrect: i === q.a }));
    const shuffled = shuffle(opts);
    return {
      q: q.q,
      o: shuffled.map(x => x.text),
      a: shuffled.findIndex(x => x.isCorrect),
      h: q.h
    };
  });

  document.getElementById('currentLevelTitle').textContent = `Level ${lv.id}: ${lv.name}`;
  document.getElementById('guideText').textContent = lv.intro;
  document.getElementById('hintCount').textContent = state.hintsLeft;
  document.getElementById('hintBtn').disabled = false;

  // Passage
  const pa = document.getElementById('passageArea');
  if (lv.passage) {
    pa.innerHTML = `<div class="passage"><h3>${lv.passage.title}</h3><p>${lv.passage.text}</p></div>`;
  } else {
    pa.innerHTML = '';
  }

  showScreen('gameScreen');
  renderQuestion();
}

function renderQuestion() {
  const q = state.shuffledQuestions[state.currentQ];
  state.answered = false;
  state.timeLeft = 30;

  document.getElementById('qProgress').textContent = `Question ${state.currentQ + 1} of ${state.shuffledQuestions.length}`;
  document.getElementById('qText').textContent = q.q;
  document.getElementById('levelScore').textContent = state.levelScore;
  document.getElementById('hintArea').innerHTML = '';
  document.getElementById('feedbackArea').innerHTML = '';
  document.getElementById('nextBtn').classList.add('hidden');
  document.getElementById('hintBtn').disabled = false;

  const optsDiv = document.getElementById('options');
  optsDiv.innerHTML = '';
  q.o.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.innerHTML = `<div class="option-letter">${String.fromCharCode(65 + i)}</div><div>${opt}</div>`;
    btn.onclick = () => selectAnswer(i, btn);
    optsDiv.appendChild(btn);
  });

  startTimer();
}

function startTimer() {
  clearInterval(state.timer);
  const timerEl = document.getElementById('timer');
  timerEl.classList.remove('warning');
  timerEl.textContent = `⏱ ${state.timeLeft}s`;

  state.timer = setInterval(() => {
    state.timeLeft--;
    timerEl.textContent = `⏱ ${state.timeLeft}s`;
    if (state.timeLeft <= 5) timerEl.classList.add('warning');
    if (state.timeLeft <= 0) {
      clearInterval(state.timer);
      timeout();
    }
  }, 1000);
}

function timeout() {
  if (state.answered) return;
  state.answered = true;
  const q = state.shuffledQuestions[state.currentQ];
  const btns = document.querySelectorAll('.option');
  btns.forEach((b, i) => {
    b.disabled = true;
    if (i === q.a) b.classList.add('correct');
  });
  document.getElementById('feedbackArea').innerHTML =
    `<div class="feedback timeout">⏰ Time's up! The correct answer was highlighted.</div>`;
  document.getElementById('nextBtn').classList.remove('hidden');
  document.getElementById('hintBtn').disabled = true;
}

function selectAnswer(idx, btn) {
  if (state.answered) return;
  state.answered = true;
  clearInterval(state.timer);

  const q = state.shuffledQuestions[state.currentQ];
  const btns = document.querySelectorAll('.option');
  btns.forEach(b => b.disabled = true);

  const fb = document.getElementById('feedbackArea');
  if (idx === q.a) {
    btn.classList.add('correct');
    state.levelScore += 10;
    state.levelCorrect++;
    fb.innerHTML = `<div class="feedback correct">✅ Correct! +10 points</div>`;
  } else {
    btn.classList.add('wrong');
    btns[q.a].classList.add('correct');
    fb.innerHTML = `<div class="feedback wrong">❌ Not quite. The correct answer was highlighted.</div>`;
  }
  document.getElementById('levelScore').textContent = state.levelScore;
  document.getElementById('nextBtn').classList.remove('hidden');
  document.getElementById('hintBtn').disabled = true;
}

function useHint() {
  if (state.hintsLeft <= 0 || state.answered) return;
  state.hintsLeft--;
  document.getElementById('hintCount').textContent = state.hintsLeft;
  if (state.hintsLeft === 0) document.getElementById('hintBtn').disabled = true;

  const q = state.shuffledQuestions[state.currentQ];
  document.getElementById('hintArea').innerHTML =
    `<div class="hint-box">💡 <b>Hint:</b> ${q.h}</div>`;
}

function nextQuestion() {
  state.currentQ++;
  if (state.currentQ >= state.shuffledQuestions.length) {
    finishLevel();
  } else {
    renderQuestion();
  }
}

/* ============================================================
   LEVEL RESULTS
   ============================================================ */
function finishLevel() {
  clearInterval(state.timer);
  const total = state.shuffledQuestions.length;
  const percent = Math.round((state.levelCorrect / total) * 100);
  let stars = 0;
  if (percent >= 90) stars = 3;
  else if (percent >= 70) stars = 2;
  else if (percent >= 50) stars = 1;

  // Update progress (keep best)
  const prev = state.levelProgress[state.currentLevel] || { stars: 0, score: 0 };
  if (stars > prev.stars || state.levelScore > prev.score) {
    state.levelProgress[state.currentLevel] = {
      stars: Math.max(stars, prev.stars),
      score: Math.max(state.levelScore, prev.score)
    };
  }

  // Recalculate totals
  state.totalScore = 0; state.totalStars = 0;
  Object.values(state.levelProgress).forEach(p => {
    state.totalScore += p.score;
    state.totalStars += p.stars;
  });

  saveProgress();
  saveLeaderboard(state.playerName, state.totalScore, state.totalStars);

  // Grade
  let grade, gradeClass, icon;
  if (percent >= 90) { grade = "Excellent!"; gradeClass = "grade-excellent"; icon = "🏆"; }
  else if (percent >= 80) { grade = "Very Good!"; gradeClass = "grade-verygood"; icon = "🥈"; }
  else if (percent >= 70) { grade = "Good!"; gradeClass = "grade-good"; icon = "🥉"; }
  else if (percent >= 60) { grade = "Keep Practicing!"; gradeClass = "grade-practice"; icon = "💪"; }
  else { grade = "Try Again!"; gradeClass = "grade-tryagain"; icon = "🔥"; }

  document.getElementById('resultIcon').textContent = icon;
  document.getElementById('resultTitle').textContent = stars > 0 ? "Level Complete!" : "Level Failed";
  document.getElementById('resultStars').textContent = '⭐'.repeat(stars) + '☆'.repeat(3 - stars);
  const gradeEl = document.getElementById('resultGrade');
  gradeEl.textContent = grade;
  gradeEl.className = 'result-grade ' + gradeClass;
  document.getElementById('rCorrect').textContent = state.levelCorrect;
  document.getElementById('rTotal').textContent = total;
  document.getElementById('rScore').textContent = state.levelScore;
  document.getElementById('rPercent').textContent = percent + '%';

  const nextBtn = document.getElementById('nextLevelBtn');
  if (state.currentLevel < 6 && stars > 0) {
    nextBtn.style.display = 'inline-block';
  } else {
    nextBtn.style.display = 'none';
  }

  if (stars === 3) confetti();
  showScreen('resultScreen');
}

function retryLevel() {
  startLevel(state.currentLevel);
}

function nextLevel() {
  if (state.currentLevel < 6) {
    startLevel(state.currentLevel + 1);
  }
}

function showMap() {
  renderMap();
  showScreen('mapScreen');
  // Check if all 6 levels completed
  const allDone = [1,2,3,4,5,6].every(id => state.levelProgress[id] && state.levelProgress[id].stars > 0);
  if (allDone) showFinal();
}

function showFinal() {
  document.getElementById('fScore').textContent = state.totalScore;
  document.getElementById('fStars').textContent = state.totalStars;
  const percent = Math.round((state.totalStars / 18) * 100);
  let grade, gradeClass;
  if (percent >= 90) { grade = "Excellent!"; gradeClass = "grade-excellent"; }
  else if (percent >= 80) { grade = "Very Good!"; gradeClass = "grade-verygood"; }
  else if (percent >= 70) { grade = "Good!"; gradeClass = "grade-good"; }
  else if (percent >= 60) { grade = "Keep Practicing!"; gradeClass = "grade-practice"; }
  else { grade = "Try Again!"; gradeClass = "grade-tryagain"; }
  const g = document.getElementById('finalGrade');
  g.textContent = grade;
  g.className = 'result-grade ' + gradeClass;
  document.getElementById('finalStars').textContent = '⭐'.repeat(state.totalStars);
  confetti();
  showScreen('finalScreen');
}

function playAgain() {
  state.totalScore = 0;
  state.totalStars = 0;
  state.levelProgress = {};
  saveProgress();
  showScreen('startScreen');
}

/* ============================================================
   LEADERBOARD
   ============================================================ */
function showLeaderboard() {
  state.previousScreen = document.querySelector('.screen.active').id;
  const lb = getLeaderboard();
  const list = document.getElementById('lbList');
  if (lb.length === 0) {
    list.innerHTML = '<p style="text-align:center; opacity:.8;">No champions yet. Be the first!</p>';
  } else {
    list.innerHTML = lb.map((p, i) => {
      const rankClass = i === 0 ? 'gold' : i === 1 ? 'silver' : i === 2 ? 'bronze' : '';
      const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1);
      return `<div class="lb-row">
        <div class="lb-rank ${rankClass}">${medal}</div>
        <div class="lb-name">${p.name}</div>
        <div style="font-size:13px; opacity:.8;">⭐${p.stars}</div>
        <div class="lb-score">💎 ${p.score}</div>
      </div>`;
    }).join('');
  }
  showScreen('leaderboardScreen');
}

function closeLeaderboard() {
  showScreen(state.previousScreen || 'startScreen');
}

/* ============================================================
   INIT
   ============================================================ */
createBubbles();
loadProgress();
if (state.playerName) {
  document.getElementById('playerName').value = state.playerName;
}
